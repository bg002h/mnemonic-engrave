/target
**/*.rs.bk
Cargo.lock.orig
.DS_Store

# Go build artifact (firmware/ndef-roundtrip)
ndefroundtrip

# cargo-fuzz generated artifacts (nightly-only fuzz crate; not CI-built). The fuzz
# crate source + its own fuzz/Cargo.lock ARE committed; these runtime dirs are not.
/crates/me-cli/fuzz/corpus
/crates/me-cli/fuzz/artifacts
/crates/me-cli/fuzz/target

# Working dir for scripts/pico2-bootkey-rehearsal.sh. Contains secp256k1 PRIVATE
# KEYS (the boot-signing keys) and generated OTP json. NEVER commit this.
rehearsal-work/
*-key.pem

# SH2 CHIPID pin + procedure state. KEEP until the SeedHammer procedure is done;
# unlike rehearsal-work/ this is not disposable. Never committed.
sh2-state/

# Personal Claude Code permissions (machine-local, not a project policy)
.claude/settings.local.json

# cargo-mutants working directories
mutants.out*/

# Playwright MCP scratch (page snapshots, console logs) — never part of the repo.
.playwright-mcp/

# Python bytecode from the design/journeys build scripts.
__pycache__/
*.pyc
